<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarAddTenant"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="@string/add_tenant_title"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <!-- Full Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFullName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/full_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Phone Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPhoneNumber"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhoneNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Alternative Phone -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAlternativePhone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/alternative_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etAlternativePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Email -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmail"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Date of Birth (DatePicker) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDateOfBirth"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/date_of_birth"
            app:endIconMode="clear_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDateOfBirth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="false"
                android:inputType="none"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- National ID (NID) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutNidNumber"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/national_id">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etNidNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Passport Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPassportNumber"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/passport_number">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassportNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Occupation -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutOccupation"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/occupation">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etOccupation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency Contact Name -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmergencyName"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/emergency_contact_name">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmergencyName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Emergency Contact Phone -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmergencyPhone"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/emergency_contact_phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmergencyPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Family Member Count -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFamilyCount"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/family_member_count">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etFamilyCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Present Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPresentAddress"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/present_address">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPresentAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="80dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Permanent Address -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutPermanentAddress"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/permanent_address">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPermanentAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="80dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Status -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTenantStatus"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/unit_status">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoTenantStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutTenantNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etTenantNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="100dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTenant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="60dp"
            android:text="@string/save_tenant"
            android:textSize="18sp"
            app:cornerRadius="18dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>
