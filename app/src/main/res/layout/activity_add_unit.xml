<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Toolbar -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbarAddUnit"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:title="@string/add_unit_title"
            app:navigationIcon="@drawable/ic_arrow_back" />

        <!-- Unit Number -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutUnitNumber"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/hint_unit_number_req"
            app:startIconDrawable="@drawable/ic_unit_key">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUnitNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Floor -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutUnitFloor"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_unit_floor"
            app:startIconDrawable="@drawable/ic_building">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoUnitFloor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Unit Type -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutUnitType"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_unit_type"
            app:startIconDrawable="@drawable/ic_building">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoUnitType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Monthly Rent -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMonthlyRent"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_unit_rent_req"
            app:startIconDrawable="@drawable/ic_payment">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMonthlyRent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Security Deposit -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutSecurityDeposit"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_unit_deposit"
            app:startIconDrawable="@drawable/ic_payment">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSecurityDeposit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="numberDecimal"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Status -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutUnitStatus"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_unit_status">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/autoUnitStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:minHeight="56dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Notes -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutUnitNotes"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/hint_property_notes">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etUnitNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textCapSentences|textMultiLine"
                android:minHeight="120dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Save -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="60dp"
            android:text="@string/save_unit"
            android:textSize="18sp"
            app:cornerRadius="18dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>

</ScrollView>